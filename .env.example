# Supabase Configuration Example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Factory Defaults
DEFAULT_EXCHANGE_RATE=4100
FACTORY_NAME_KH=សហគ្រាសផលិតទឹកបរិសុទ្ធ អេស អរ ភី
